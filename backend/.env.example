# ===== Conexión a MongoDB (obligatoria) =====
# Atlas: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/stock-demo

# ===== Seguridad (obligatorio) =====
# Mínimo 16 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_16_caracteres

# Orígenes permitidos por CORS, separados por coma
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# URL pública del frontend para generar enlaces de demo clickeables (en producción se omite y se usa el origin del request)
FRONTEND_URL=http://localhost:5173

# ===== Usuarios semilla (obligatorio) =====
ADMIN_EMAIL=admin@nexus.com
ADMIN_PASSWORD=admin123456
EMPLEADO_EMAIL=empleado@nexus.com
EMPLEADO_PASSWORD=empleado123456

# ===== Opcionales =====
# PORT=5000
# MAIL_TO=destino@correo.com
# MAIL_FROM="NexusCode" <remitente@correo.com>
# BREVO_API_KEY=xxxx
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USER=xxxx
# MAIL_PASS=xxxx
# VAPID_PUBLIC_KEY=xxxx
# VAPID_PRIVATE_KEY=xxxx
# VAPID_SUBJECT=mailto:admin@nexus.com